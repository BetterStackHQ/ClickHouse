-- two different subqueries with the same projection, keys from both
0	0	20
1	1	15
1	2	3
SELECT
    __table1.a AS a,
    __table3.a AS `y.a`
FROM
(
    SELECT 1 AS a
    FROM system.one AS __table2
) AS __table1,
(
    SELECT 2 AS a
    FROM system.one AS __table4
) AS __table3
GROUP BY
    __table1.a,
    __table3.a
-- the same CTE joined to itself, keys from both sides
0	0	3
1	1	3
-- JOIN USING and ARRAY JOIN sources
0	1	9
1	2	9
0	0	5
1	2	5
2	4	2
SELECT
    __array_join_exp_1 AS x,
    __array_join_exp_1 * 2 AS `multiply(x, 2)`,
    count() AS `count()`
FROM
(
    SELECT [__table3.number % 2, __table3.number % 3] AS arr
    FROM numbers(6) AS __table3
) AS __table2
ARRAY JOIN __table2.arr AS __array_join_exp_1
GROUP BY __array_join_exp_1
