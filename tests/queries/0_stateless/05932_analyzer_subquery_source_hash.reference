1	2	12	2
-- group_by_use_nulls with subquery keys
0	\N	3
1	\N	3
\N	0	2
\N	1	2
\N	2	2
-- HAVING with a subquery over a subquery key
0	3
1	3
-- keys from a three-level subquery stack
0	0	0	2
0	1	1	2
1	0	1	2
1	1	2	2
2	0	2	2
2	1	3	2
SELECT
    __table1.a AS a,
    __table1.b AS b,
    __table1.a + __table1.b AS `plus(a, b)`,
    count() AS `count()`
FROM
(
    SELECT
        __table2.a AS a,
        __table2.b AS b
    FROM
    (
        SELECT
            __table3.a AS a,
            __table3.number % 2 AS b
        FROM
        (
            SELECT
                __table4.number % 3 AS a,
                __table4.number AS number
            FROM numbers(12) AS __table4
        ) AS __table3
    ) AS __table2
) AS __table1
GROUP BY
    __table1.a,
    __table1.b
