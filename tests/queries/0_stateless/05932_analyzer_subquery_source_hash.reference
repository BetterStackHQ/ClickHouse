-- function of a subquery key is dropped from GROUP BY
0	1	10
1	2	10
2	3	10
SELECT
    __table1.a AS a,
    __table1.a + 1 AS `plus(a, 1)`,
    count() AS `count()`
FROM
(
    SELECT __table2.number % 3 AS a
    FROM numbers(30) AS __table2
) AS __table1
GROUP BY __table1.a
-- aggregate of a subquery key is replaced by the key
0	0	1	5
1	1	2	5
2	2	3	5
3	3	4	5
SELECT
    __table1.a AS a,
    __table1.a AS `max(a)`,
    __table1.a + 1 AS `min(plus(a, 1))`,
    count() AS `count()`
FROM
(
    SELECT __table2.number % 4 AS a
    FROM numbers(20) AS __table2
) AS __table1
GROUP BY __table1.a
